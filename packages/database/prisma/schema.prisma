generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Banner {
  id        String   @id
  imagePath String
  link      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime
}

model MegaMenuBrand {
  id        String   @id
  name      String
  logoPath  String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime
}

model Product {
  id              String   @id
  name            String
  brand           String
  priceUSD        Float
  createdAt       DateTime @default(now())
  updatedAt       DateTime
  bgColor         String?  @default("#ffffff")
  notesBase       String?
  notesHeart      String?
  notesTop        String?
  discount        Float    @default(0)
  imagePath       String?
  inStock         Boolean  @default(true)
  slug            String   @unique
  volumeMl        Int      @default(100)
  homepageOrder   Int      @default(0)
  homepageSection String?  @default("NINGUNO")
  gender          String   @default("Unisex")
}

model Sale {
  id          String   @id
  clientName  String
  productId   String?
  productName String
  totalAmount Float
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  amountPaid  Float    @default(0)
}

model Settings {
  id               String   @id @default("1")
  dollarRate       Float    @default(1000)
  updatedAt        DateTime
  address          String   @default("Brandsen, 257, Formosa")
  phone            String   @default("+541124072012")
  whatsapp         String   @default("+541124072012")
  filtersPosition  String   @default("izquierda")
  promoBannerPath  String   @default("/beauty_sale_banner.jpg")
  showPromoCard    Boolean  @default(true)
  novedadProductId String?
}
