{
  "name": "jc-import-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "postinstall": "npm run db:generate --workspace=database",
    "db:generate": "npm run db:generate --workspace=database",
    "db:push": "npm run db:push --workspace=database"
  }
}
